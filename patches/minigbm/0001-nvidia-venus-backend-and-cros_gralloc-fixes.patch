diff --git a/cros_gralloc/cros_gralloc_driver.cc b/cros_gralloc/cros_gralloc_driver.cc
index cb8b94b..66b3337 100644
--- a/cros_gralloc/cros_gralloc_driver.cc
+++ b/cros_gralloc/cros_gralloc_driver.cc
@@ -342,10 +342,18 @@ int32_t cros_gralloc_driver::allocate(const struct cros_gralloc_buffer_descripto
 		goto destroy_hnd;
 	}
 
-	ret = buffer->initialize_metadata(descriptor);
-	if (ret) {
-		ALOGE("Failed to allocate: failed to initialize cros_gralloc_buffer metadata.");
-		goto destroy_hnd;
+	/*
+	 * initialize_metadata() writes into the reserved region created above -
+	 * only meaningful (and only actually created) when the caller asked for
+	 * one. Calling it unconditionally fails every allocation whose caller
+	 * doesn't request metadata_fd support, independent of any backend.
+	 */
+	if (descriptor->enable_metadata_fd) {
+		ret = buffer->initialize_metadata(descriptor);
+		if (ret) {
+			ALOGE("Failed to allocate: failed to initialize cros_gralloc_buffer metadata.");
+			goto destroy_hnd;
+		}
 	}
 
 	{
@@ -366,7 +374,15 @@ destroy_hnd:
 	native_handle_close(hnd);
 	native_handle_delete(hnd);
 
-	drv_bo_destroy(bo);
+	/*
+	 * If `buffer` was already constructed (the goto came from the
+	 * initialize_metadata() failure below, not an earlier one), its own
+	 * destructor calls drv_bo_destroy(bo) when it goes out of scope on
+	 * return - doing it again here double-destroys bo. Only destroy it
+	 * explicitly when nothing else owns it yet.
+	 */
+	if (!buffer)
+		drv_bo_destroy(bo);
 	return ret;
 }
 
